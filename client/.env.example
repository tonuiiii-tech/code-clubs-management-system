# Copy to client/.env. Everything here is bundled into the browser app,
# so never put secrets in this file.
VITE_API_URL=http://localhost:4000/api/v1

# true = use the in-browser mock API with fictional demo data instead of the server.
# `npm run demo` turns this on for you (see client/.env.demo).
VITE_USE_MOCKS=false
