# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000

# Allowed browser origin for CORS (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Address of the app, used in invitation links (D5-15). Default: the first CORS_ORIGIN.
APP_URL=

# MongoDB connection string (D1-8, D1-23). Either:
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/code-clubs
#   Local:  mongodb://localhost:27017/code-clubs
MONGODB_URI=

# Long random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Development only: password for the seeded demo accounts (default: the demo-mode password)
SEED_DEFAULT_PASSWORD=
