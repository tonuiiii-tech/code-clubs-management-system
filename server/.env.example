# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000

# Allowed browser origin for CORS (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Database connection string. Engine still pending (decision D1-8):
#   PostgreSQL: postgres://user:password@localhost:5432/code_clubs
#   MongoDB:    mongodb://localhost:27017/code_clubs
DATABASE_URL=

# Long random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Development only: password given to seeded accounts
SEED_DEFAULT_PASSWORD=
